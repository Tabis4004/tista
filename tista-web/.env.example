# =============================================================================
# TiSta+ — Console web
# Copier vers .env avant de lancer ./deploy.sh
# =============================================================================
#
# IMPORTANT : Vite inline ces valeurs AU MOMENT DU BUILD.
# Comme deploy.sh construit en local puis pousse dist/ avec wrangler, ce sont
# ces variables-ci qui partent en production — pas celles du dashboard
# Cloudflare. Les variables Cloudflare ne comptent que si c'est Cloudflare qui
# construit (intégration Git).
#
# Dashboard : https://supabase.com/dashboard/project/nwzohcwxusdcyxzzmkcr

VITE_SUPABASE_URL=https://nwzohcwxusdcyxzzmkcr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_bnGhLeAW0AlQ1RJFvaa7GQ_aHA6w4Hw

# Nom du projet Cloudflare Pages (utilisé par deploy.sh)
CF_PAGES_PROJECT=tista-web

# ⚠️ Ne JAMAIS mettre SUPABASE_SERVICE_ROLE_KEY ici.
# Cette clé contourne la RLS ; tout ce qui entre dans un build web est lisible
# par n'importe quel visiteur.
